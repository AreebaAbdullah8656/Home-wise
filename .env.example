# HomeWise environment variables
# 1. Copy this file to .env.local (never commit .env.local)
# 2. Fill in values from your Supabase / API dashboards
# 3. Restart npm run dev after editing
# Never put real secrets in source code or git commits.

# ---------------------------------------------------------------------------
# Supabase (Auth, Postgres, Storage)
# .env.local must be a FILE (not a folder).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias if your dashboard labels the key "publishable" instead of "anon":
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only key. Prefer user JWT + RLS; only use if a later
# admin/server task truly needs it. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Gemini API — server-side only (NL expenses, bill OCR, AI saving tips)
# Missing key disables OCR / NL / AI tips only; manual entry + curated tips work.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Preferred: ordered fallback models (comma-separated).
# Default when unset: gemini-3.8-flash,gemini-3.1-flash-lite
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite

# Legacy single-model override (still supported). Prefer GEMINI_MODELS above.
# GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Smart Recommendations — live nearby stores (server-only)
# Default provider: OpenStreetMap (Nominatim + Overpass). No key required.
# Optional Google Places when a Maps key is set:
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
# GOOGLE_PLACES_API_KEY=

# OSM usage policy: identifying User-Agent with a reachable contact is required.
# Nominatim returns HTTP 403 for missing UA or placeholder example.com contacts.
# Overpass returns HTTP 406 without an identifying UA.
NOMINATIM_CONTACT_EMAIL=
# Optional full UA override (skips NOMINATIM_CONTACT_EMAIL formatting):
# NOMINATIM_USER_AGENT=
# OVERPASS_USER_AGENT=
# NOMINATIM_ACCEPT_LANGUAGE=en
# NOMINATIM_URL=
# OVERPASS_API_URL=
