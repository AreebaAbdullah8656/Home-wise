# HomeWise environment variables
# 1. Copy this file to .env.local (never commit .env.local)
# 2. Fill in values from your Supabase project Settings → API
# 3. Restart npm run dev after editing
# Never put real secrets in source code or git commits.

# Supabase (Auth, Postgres, Storage) — required for Phase 3 auth/data
# .env.local must be a FILE (not a folder). Copy this file, then fill values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias if your dashboard labels the key "publishable" instead of "anon":
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only key. Prefer user JWT + RLS; only use if a later
# admin/server task truly needs it. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API — server-side only (NL expenses Phase 4, bill OCR Phase 5)
# Do not expose this key to the browser.
GEMINI_API_KEY=
