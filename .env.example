# HomeWise environment variables
# 1. Copy this file to .env.local (never commit .env.local)
# 2. Fill in values from your Supabase project Settings → API
# 3. Restart npm run dev after editing
# Never put real secrets in source code or git commits.

# Supabase (Auth, Postgres, Storage) — required for Phase 3 auth/data
# .env.local must be a FILE (not a folder). Copy this file, then fill values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias if your dashboard labels the key "publishable" instead of "anon":
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only key. Prefer user JWT + RLS; only use if a later
# admin/server task truly needs it. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API — server-side only (NL expenses, bill OCR, AI saving tips)
# Do not expose this key to the browser. Missing key disables OCR/NL/AI tips only;
# manual expense entry and curated tips still work.
GEMINI_API_KEY=

# Preferred: ordered fallback models (comma-separated).
# Default when unset: gemini-3.8-flash,gemini-3.1-flash-lite
# On 503/429/timeout the server retries (2x) then tries the next model.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite

# Legacy single-model override (still supported). Prefer GEMINI_MODELS above.
# GEMINI_MODEL=gemini-3.8-flash

# Smart Recommendations — live nearby stores (server-only)
# Default provider: OpenStreetMap (Nominatim geocode + Overpass shops). No key required.
# Optional Google Places when a key is set (takes priority over OSM):
# Enable in Google Cloud: Places API (New) + Geocoding API.
GOOGLE_MAPS_API_KEY=
# Optional alias (same key):
# GOOGLE_PLACES_API_KEY=

# OSM usage policy: identifying User-Agent with a real contact is required.
# Nominatim returns HTTP 403 for missing UA or placeholder example.com contacts.
# Overpass returns HTTP 406 without an identifying UA.
# Contact email is embedded as: HomeWise/1.0 (contact: <email>)
NOMINATIM_CONTACT_EMAIL=abdulahad.abdullah8656@gmail.com
# Optional full UA override (skips NOMINATIM_CONTACT_EMAIL formatting):
# NOMINATIM_USER_AGENT=HomeWise/1.0 (contact: you@example.com)
# OVERPASS_USER_AGENT=HomeWise/1.0 (contact: you@example.com)
# NOMINATIM_ACCEPT_LANGUAGE=en
# Optional URL overrides:
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# On Nominatim 403/429 the app falls back to Photon then Open-Meteo geocoding.
# On Overpass 406/429/503/504 (or timeout) it also tries overpass.kumi.systems and overpass.private.coffee.
# Prefer saved/device lat/lng so geocoding is skipped.
# Geocoding is Pakistan-only (Nominatim countrycodes=pk + ", Pakistan" suffix;
# Photon bbox / Open-Meteo countryCode=PK; results outside PK bbox are rejected).
# Overpass: one shop category per light around: query (default 2 km, max 5 km).
# On Overpass timeout, falls back to Nominatim bounded search near the point.

