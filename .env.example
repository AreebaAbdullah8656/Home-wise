# HomeWise environment variables (Phase 2+)
# Copy to .env.local and fill in values when you reach Phase 3+.
# Never commit real secrets.

# Supabase (Auth, Postgres, Storage) — required from Phase 3
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only if needed; prefer user JWT + RLS over service role
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API — server-side only (NL expenses Phase 4, bill OCR Phase 5)
# Do not expose this key to the browser.
GEMINI_API_KEY=
